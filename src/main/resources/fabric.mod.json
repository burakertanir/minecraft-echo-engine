{
  "schemaVersion": 1,
  "id": "audiophilecraft",
  "version": "${version}",
  "name": "ECHO Sound Engine",
  "description": "Physical speaker arrays, spatial audio, occlusion and venue acoustics for Minecraft.",
  "authors": [
    "Burak"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.audiophilecraft.AudiophileCraft"
    ],
    "client": [
      "com.audiophilecraft.AudiophileCraftClient"
    ]
  },
  "mixins": [
    "audiophilecraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.7",
    "minecraft": "~1.20.1",
    "java": ">=17",
